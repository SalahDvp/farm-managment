# ---------------------------------------------------------------------------
# Copy this file to ".env.local", fill it in, and restart `pnpm dev`.
#
# Firebase web config — Project settings → General → Your apps → Web app (</>)
# → "SDK setup and configuration" → Config. These values identify the project
# and are safe in the browser; access is enforced by Firebase Auth and
# firestore.rules.
#
# Without them the app runs on an in-memory demo store with no accounts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
